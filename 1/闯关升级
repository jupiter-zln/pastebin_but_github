#include <bits/stdc++.h>
using namespace std;
#define int long long
const int N = 1e6 + 10;
int n, t, ans, a[N], b[N];

signed main()
{
	cin >> n >> t;
	for (int i = 1; i <= n; i++)
	{
		int x;
		cin >> x;
		a[i] = a[i - 1] + x;
	}
	for (int i = 1; i <= n; i++)
	{
		int x;
		cin >> x;
		b[i] = b[i - 1] + x;
	}
	// 从第一关开始打游戏b，最后一关打游戏a
	int l = n, r = 0;
	while (l >= 1 && r <= n)
	{
		if (a[l] + b[r] <= t)
		{
			ans = max(ans, l + r);
			r++;
		}
		else
		{
			l--;
		}
	}

	// 全部打游戏b
	while (l < 1 && r <= n)
	{
		if (b[r] <= t)
		{
			ans = max(ans, r);
			r++;
		}
		else
		{
			break;
		}
	}
	cout << ans << endl;
	return 0;
}
